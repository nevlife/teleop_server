# Teleop v2 development TURN relay.
# Signaling uses TCP/13437; TURN listens on UDP/13438 and relays media on
# UDP/13439-13442. Forward TCP 13437 and UDP 13438-13442 at the router.
listening-port=13438
listening-ip=0.0.0.0
min-port=13439
max-port=13442

fingerprint
lt-cred-mech
realm=teleop.local
user=teleop:teleop-dev

# UDP-only keeps TCP/13437 available for the signaling service; the TURN
# endpoint itself moved to UDP/13438 so the two protocols use distinct numbers.
no-tcp
no-tls
no-dtls
no-cli
no-multicast-peers
stale-nonce=600

# When the server is behind NAT, copy this file and set:
# external-ip=PUBLIC_IP/PRIVATE_LAN_IP
